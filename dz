#include <iostream> 
#include <iomanip> 

using namespace std; 
int main() { 

    int n = 10; 
    // Создание матрицы 10x10 
    int matrix[10][10]; 
    // Заполнение матрицы 
    for (int i = 0; i < n; i++) { 
        for (int j = 0; j < n; j++) { 
            if (i + j < n - 1) { 
                matrix[i][j] = i + 1; 
            } else if (i + j == n - 1) { 
                matrix[i][j] = i + 1; 
            } else { 
                matrix[i][j] = 0; 
            } 
        } 
    } 
    // Вывод матрицы 10x10 
    cout << "\nМатрица 10x10:" << endl; 
    for (int i = 0; i < n; i++) { 
        for (int j = 0; j < n; j++) { 
            cout << setw(2) << matrix[i][j] << " "; 
        } 
        cout << endl; 
    } 
    // Проверка нескольких элементов 
    cout << "\nПроверка элементов:" << endl; 
    cout << "matrix[0][0] = " << matrix[0][0] << " (должно быть 1)" << endl; 
    cout << "matrix[1][8] = " << matrix[1][8] << " (должно быть 2)" << endl; 
    cout << "matrix[5][4] = " << matrix[5][4] << " (должно быть 6)" << endl; 
    cout << "matrix[9][9] = " << matrix[9][9] << " (должно быть 0)" << endl; 

    return 0; 
}
