#include <iostream> 
#include <cstdlib> 
#include <ctime> 

using namespace std; 
const int SIZE = 10;  // размер массива 
const int MAX_VALUE = 90;  // максимальное значение элементов 

int main() { 
    int arr[SIZE]; 
    int sumEven = 0, productOdd = 1, countEven = 0, countOdd = 0; 
    // Инициализация генератора случайных чисел 
    srand(time(0)); 
    cout << "=== ОБРАБОТКА ОДНОМЕРНОГО МАССИВА ===" << endl; 
    cout << endl; 
    // Заполнение массива случайными числами 
    cout << "Заполнение массива случайными числами до " << MAX_VALUE << ":" << endl; 
    for (int i = 0; i < SIZE; i++) { 
        arr[i] = rand() % (MAX_VALUE + 1); 
        cout << "arr[" << i << "] = " << arr[i] << endl; 
    } 
    cout << endl; 
    // Вывод массива 
    cout << "Сформированный массив: "; 
    cout << "["; 
    for (int i = 0; i < SIZE; i++) { 
        cout << arr[i]; 
        if (i < SIZE - 1) cout << ", "; 
    } 

    cout << "]" << endl; 
    cout << endl; 
    // Обработка массива - подсчет суммы четных и произведения нечетных элементов 
    cout << "Обработка массива:" << endl; 
    for (int i = 0; i < SIZE; i++) { 
        cout << "i = " << i << ", arr[" << i << "] = " << arr[i]; 
        
        if (arr[i] % 2 == 0) { 
            // Четный элемент 
            sumEven += arr[i]; 
            countEven++; 
            cout << " - четный, сумма = " << sumEven << ", количество = " << countEven; 

        } else { 
            // Нечетный элемент 
            productOdd *= arr[i]; 
            countOdd++; 
            cout << " - нечетный, произведение = " << productOdd << ", количество = " << countOdd; 
        } 
        cout << endl; 
    } 

    cout << endl; 
    // Вывод результатов 
    cout << "=== РЕЗУЛЬТАТЫ ОБРАБОТКИ ===" << endl; 
    cout << "Сумма четных элементов: " << sumEven << endl; 
    cout << "Количество четных элементов: " << countEven << endl; 
    cout << "Произведение нечетных элементов: " << productOdd << endl; 
    cout << "Количество нечетных элементов: " << countOdd << endl; 
    return 0; 
} 


